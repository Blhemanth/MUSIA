# ==============================================================================
# MUSIA Quantum Studio - Environment Configuration
# ==============================================================================

# Active Google Colab ngrok tunnel URL (e.g. https://xxxx-xx-xx-xx.ngrok-free.dev)
# Set in Vercel Project Settings -> Environment Variables
COLAB_NGROK_URL=https://your-colab-tunnel.ngrok-free.dev

# Shared secret token for authenticating Colab GPU bridge requests
# Must match COLAB_SECRET_TOKEN in colab_gpu_server.py
COLAB_SECRET_TOKEN=your_secure_random_token_here

# Local Development Settings
PORT=8000
ENVIRONMENT=development
